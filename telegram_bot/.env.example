# Attendix Telegram Bot Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file or credentials to git!

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. MITS IMS Base URL
IMS_BASE_URL=http://mitsims.in

# 3. Database Path (SQLite)
# For local and single-instance deployments with persistent disk:
DATABASE_PATH=telegram_bot.db

# 4. Credential Encryption Key
# 32 url-safe base64-encoded bytes (Fernet key).
# You can generate one using:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, a key will be auto-generated in telegram_bot/.encryption_key
CREDENTIAL_ENCRYPTION_KEY=

# 5. Performance and Caching
CACHE_TTL_SECONDS=300
MAX_CONCURRENT_SCRAPES=2
